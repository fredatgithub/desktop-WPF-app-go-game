<Window x:Class="GoGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go Game" Height="800" Width="1000"
        Background="#F5F5DC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Game Board -->
        <Border Grid.Column="0" Background="#D2B48C" Margin="20" 
                BorderBrush="#8B4513" BorderThickness="3">
            <Canvas x:Name="BoardCanvas" 
                    Width="600" Height="600"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Canvas.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DEB887" Offset="0"/>
                        <GradientStop Color="#D2B48C" Offset="0.5"/>
                        <GradientStop Color="#CD853F" Offset="1"/>
                    </LinearGradientBrush>
                </Canvas.Background>
            </Canvas>
        </Border>

        <!-- Control Panel -->
        <StackPanel Grid.Column="1" Margin="10" Background="White" 
                    Orientation="Vertical">
            <Border Background="#2C3E50" Padding="10" Margin="0,0,0,10">
                <TextBlock Text="Go Game" Foreground="White" 
                          FontSize="20" FontWeight="Bold" 
                          HorizontalAlignment="Center"/>
            </Border>

            <!-- Current Player -->
            <Border Background="#ECF0F1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Current Player:" FontWeight="Bold" 
                              HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                               Margin="0,5,0,0">
                        <Ellipse x:Name="CurrentPlayerStone" 
                                Width="20" Height="20" 
                                Stroke="#333" StrokeThickness="1"
                                Fill="Black" Margin="0,0,5,0"/>
                        <TextBlock x:Name="CurrentPlayerText" Text="Black" 
                                  VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Score -->
            <Border Background="#ECF0F1" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Captured Stones:" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="15" Height="15" Fill="Black" 
                                Stroke="#333" StrokeThickness="1" 
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="BlackCapturedText" Text=" : 0" 
                                  VerticalAlignment="Center" Margin="5,0,15,0"/>
                        
                        <Ellipse Width="15" Height="15" Fill="White" 
                                Stroke="#333" StrokeThickness="1" 
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="WhiteCapturedText" Text=" : 0" 
                                  VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Game Status -->
            <Border Background="#E8F5E8" Padding="10" Margin="0,0,0,10">
                <TextBlock x:Name="GameStatusText" Text="Game in Progress" 
                          HorizontalAlignment="Center" FontWeight="Bold" 
                          Foreground="#27AE60"/>
            </Border>

            <!-- Controls -->
            <Button x:Name="PassButton" Content="Pass" 
                    Height="35" Margin="0,0,0,10" 
                    Background="#3498DB" Foreground="White" 
                    FontWeight="Bold" Click="PassButton_Click"/>
            
            <Button x:Name="NewGameButton" Content="New Game" 
                    Height="35" Margin="0,0,0,10"
                    Background="#E74C3C" Foreground="White" 
                    FontWeight="Bold" Click="NewGameButton_Click"/>

            <!-- Instructions -->
            <Border Background="#F8F9FA" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="How to Play:" FontWeight="Bold" 
                              Margin="0,0,0,5"/>
                    <TextBlock Text="• Click on intersections to place stones" 
                              TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="• Capture opponent stones by surrounding them" 
                              TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="• Click Pass to skip your turn" 
                              TextWrapping="Wrap" Margin="0,2"/>
                    <TextBlock Text="• Game ends when both players pass" 
                              TextWrapping="Wrap" Margin="0,2"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>